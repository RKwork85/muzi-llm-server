# 复制为 .env 后填写。不要提交真实密钥。
# 模型 ID 以 DeepSeek 官方更新日志为准。下面的默认值核验于 2026-11-06。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TIMEOUT_SECONDS=180
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_ALLOWLIST=deepseek-flash,deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_RETRY_BACKOFF_SECONDS=0.2
# 本服务默认显式关闭思考模式。上游在省略 thinking 时默认开启。
DEEPSEEK_THINKING=disabled
LOG_LEVEL=INFO
REQUIRE_API_KEY_ON_STARTUP=false
EXPOSE_REASONING=false
MAX_TOOL_ROUNDS=10
TOOL_ROUND_HARD_LIMIT=10
TOOL_TIMEOUT_SECONDS=2
TOOL_RESULT_MAX_CHARS=4000
# 工具固定计费（token）。系统内部只认 token，人民币换算在充值/定价系统。
# 命名约定 TOOL_PRICE_<工具名大写>_TOKENS，不写则用代码默认值。
# 图片生成：每成功生成一张图扣的 token（Seedream 0.12 元/张，暂定 150000）。
TOOL_PRICE_IMAGE_GENERATION_TOKENS=150000
# 文件交付：每次成功调用扣的 token。
TOOL_PRICE_DELIVER_FILE_TOKENS=2000
LLM_PROVIDER=deepseek
# Agent Runtime。这些值都有硬上限，请求不能放宽。
AGENT_MAX_ACTIVE_TASKS=8
AGENT_TASK_TTL_SECONDS=300
AGENT_SYNC_TOOL_CONCURRENCY=2
AGENT_CANCEL_CLEANUP_SECONDS=2
# 工具扩展。默认关闭网络和文件工具。工作区不能指向项目根目录。
# 推荐指向项目内的 agent_workspace，该目录只保留 .gitkeep，其余内容不提交。
# 线上请求按 X-Workspace-Key 进入独立子目录。没有合法密钥时不能读取根目录里的文件。
TOOLS_NETWORK_ENABLED=false
TOOLS_WORKSPACE_ROOT=
# 沙箱命令白名单，逗号分隔，只写命令名。默认不授权任何命令。
TOOLS_SANDBOX_COMMANDS=
# 默认沙盒超时；纯计算可在单次调用里申请更久，但不超过 TOOLS_SANDBOX_TIMEOUT_MAX。
TOOLS_SANDBOX_TIMEOUT_SECONDS=10
TOOLS_SANDBOX_TIMEOUT_MAX=60
# local 后端：联网默认开启（装依赖需要）。设 false 会注入黑洞代理并禁止 pip 索引，
# 属于协作式断网；需要内核级隔离请用 SANDBOX_BACKEND=agentbox。
SANDBOX_BACKEND=local
SANDBOX_NETWORK_ENABLED=true
# 是否把工作区暴露给沙盒：local 走 MUZI_WORKSPACE 环境变量，agentbox 挂载 /workspace:ro。
SANDBOX_WORKSPACE_ACCESS=true
# 依赖安装限制：只允许预编译轮子（--only-binary），运行期从本地预热缓存离线解压。
# max_packages = 顶层包名个数（传递依赖不计数）；max_mb / timeout = 整次安装的总量。
# 首次部署先执行 python scripts/warm_sandbox_wheels.py 灌满缓存。
SANDBOX_DEPENDENCIES_ENABLED=true
SANDBOX_DEPENDENCY_ALLOWLIST=python-docx,openpyxl,pypdf,python-pptx,xlsxwriter,markdown,beautifulsoup4,reportlab,pillow,pydub,mutagen,ffmpeg-python,qrcode
SANDBOX_DEPENDENCY_MAX_PACKAGES=6
SANDBOX_DEPENDENCY_MAX_MB=48
SANDBOX_DEPENDENCY_TIMEOUT_SECONDS=45
SANDBOX_DEPENDENCY_FROM_CACHE=true
SANDBOX_DEPENDENCY_CACHE_DIR=sandbox_wheel_cache
SANDBOX_DEPENDENCY_CACHE_DIR=sandbox_wheel_cache
TOOLS_NETWORK_CONCURRENCY=4
AGENT_MAX_ARTIFACTS=5
AGENT_MAX_ARTIFACT_CHARS=20000
# 联网工具。抓取由 DeepSeek 服务器执行，密钥复用 DEEPSEEK_API_KEY。
WEB_TOOLS_MAX_RETRIES=0
WEB_TOOLS_RETRY_BACKOFF_SECONDS=0.2
WEB_FETCH_URL_POLICY=provenance
WEB_SEARCH_SEND_ORI_QUESTION=false
WEB_RESPONSE_MAX_BYTES=2000000
WEB_FETCH_ALLOWED_DOMAINS=
WEB_FETCH_DENIED_DOMAINS=
WEB_FETCH_BLOCK_CREDENTIAL_QUERY=true
WEB_SEARCH_MAX_CALLS=2
WEB_FETCH_MAX_CALLS=2
# 数据处理。目录不能是项目根。文件保留时间和任务 TTL 彼此独立。
DATA_STORE_ROOT=data_store
DATA_FILE_TTL_SECONDS=3600
DATA_DOWNLOAD_TTL_SECONDS=600
DATA_MAX_ROWS=5000
DATA_MAX_BYTES=1000000
DATA_MAX_COLUMNS=64
DATA_SAMPLE_ROWS=3
DATA_MAX_PACKAGE_FILES=20
DATA_MAX_PACKAGE_BYTES=2000000
# 对象存储上传。留空时数据工具只返回本机短期下载路径。
# 地址指向 qs-oss 这种上传服务，不在这里填写 OSS AccessKey。
OSS_UPLOAD_BASE_URL=
OSS_UPLOAD_PREFIX=agent-data
OSS_UPLOAD_TIMEOUT_SECONDS=20
# muzi-oss 开了 API_TOKEN 时必须与之一致，否则上传全部 401。留空表示网关不鉴权。
OSS_UPLOAD_TOKEN=
# qs-datacapture 直调采集服务（改造后封装成常驻 HTTP 服务）。留空则内容创作采集不可用。
QS_DATACAPTURE_BASE_URL=http://127.0.0.1:3780
QS_DATACAPTURE_USERNAME=admin
QS_DATACAPTURE_PASSWORD=admin123
QS_DATACAPTURE_TIMEOUT_SECONDS=600
# MCP。默认关闭。命令必须是本机可执行文件的绝对路径，参数用逗号分隔。
# 只导入白名单里的远端工具名。不要把密钥写进这里。
MCP_ENABLED=false
MCP_SERVER_NAME=server
MCP_COMMAND=
MCP_ARGS=
MCP_TOOL_ALLOWLIST=
MCP_TOOLS_NETWORK=false
MCP_TIMEOUT_SECONDS=10
# 远程 MCP。目录在 app/mcp/connectors.toml。令牌加密密钥只放在本机 .env。
MCP_TOKEN_KEY=
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8000
MCP_FRONTEND_BASE_URL=http://127.0.0.1:5500
MCP_ALLOW_INSECURE=false
# 运行环境。development（默认）时分享链接用请求来源的 host，便于本地调试；
# production 时固定使用 SHARE_PUBLIC_BASE_URL。
RUNTIME_ENV=development
# 分享链接的对外站点根地址。生产环境默认 https://muzihhh.com。
SHARE_PUBLIC_BASE_URL=https://muzihhh.com
# 数据库。密码只放在本机 .env，不写进此示例。
# Windows 本机运行时主机用 127.0.0.1。FastAPI 进入 Docker 后改为 postgres / redis。
# 复制 deploy/docker/.env 里生成的密码后再把 DATABASE_STARTUP_REQUIRED 改为 true。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=muzi_llm
POSTGRES_USER=muzi_admin
POSTGRES_PASSWORD=
# 数据库连接池（默认 5+10 偏小，可按部署环境调整）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
DATABASE_STARTUP_REQUIRED=false
# 启动时若检测到数据库 schema 落后，自动执行 alembic upgrade head。
# 本地/单实例开发建议保持 true；生产建议设为 false 走独立迁移流水线。
AUTO_MIGRATE=true
# 技能包注册表目录。相对路径相对服务根目录。留空时不加载注册表技能。
SKILLS_ROOT=skills_data
# 阿里云短信。四项都填写后，登录页「获取验证码」才会真正下发。
# 模板变量名需与短信模板一致，默认模板里写 ${code}。
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_TEMPLATE_PARAM_KEY=code
SMS_ENDPOINT=dysmsapi.aliyuncs.com
SMS_CODE_TTL_SECONDS=300
SMS_COOLDOWN_SECONDS=60
SMS_CODE_LENGTH=6
# 回执队列。开通云通信消息回执后填写队列名，再把开关改为 true。
# 队列名形如 Alicom-Queue-账号ID-SmsReport。MNS 地址使用云通信固定域名。
SMS_RECEIPT_ENABLED=false
SMS_MNS_ENDPOINT=https://1943695596114318.mns.cn-hangzhou.aliyuncs.com
SMS_MNS_QUEUE_NAME=
SMS_MNS_MESSAGE_TYPE=SmsReport
# 邮箱验证码登录（标准 SMTP，换供应商只改这里）。
# QQ 邮箱：先到「设置 - 账号」开启 IMAP/SMTP 服务，再生成 16 位授权码填到 MAIL_PASSWORD，
# 注意不是 QQ 登录密码；MAIL_FROM 必须与 MAIL_USERNAME 完全一致，否则会被拒绝发送。
# 465 用隐式 SSL（MAIL_USE_SSL=true）；587 用 STARTTLS（MAIL_USE_SSL=false + MAIL_START_TLS=true）。
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=MUZI-让思想自由生长
MAIL_USE_SSL=true
MAIL_START_TLS=false
MAIL_TIMEOUT_SECONDS=10
MAIL_CODE_TTL_SECONDS=600
MAIL_COOLDOWN_SECONDS=60
MAIL_CODE_LENGTH=6
# 防滥用：同邮箱 / 同 IP 每小时上限，以及全局每日上限。
MAIL_HOURLY_LIMIT_PER_EMAIL=5
MAIL_HOURLY_LIMIT_PER_IP=20
MAIL_DAILY_LIMIT=200
# 禁止发信与登录的内部占位域名，逗号分隔。手机号账号的邮箱形如 <phone>@phone.local。
MAIL_BLOCKED_DOMAINS=phone.local
MAIL_SUBJECT=MUZI-让思想自由生长 注册验证码
# 验证码摘要 pepper，留空时回落到 MAIL_PASSWORD、MAIL_HOST。
MAIL_CODE_PEPPER=
# 备用发信账号：主账号连不上/认证失败时自动切过去。留空表示不启用。
# 必须是另一个能独立登录的邮箱；用同一个账号填两遍没有意义，
# 因为授权码失效或域名被封会同时命中两份配置。
# 留空时 MAIL_BACKUP_FROM 回落到 MAIL_BACKUP_USERNAME（QQ 要求两者一致）。
MAIL_BACKUP_HOST=
MAIL_BACKUP_PORT=465
MAIL_BACKUP_USERNAME=
MAIL_BACKUP_PASSWORD=
MAIL_BACKUP_FROM=
MAIL_BACKUP_USE_SSL=true
MAIL_BACKUP_START_TLS=false
# 主账号被判定不可用后跳过它的秒数。0 表示每次都按顺序重试、不记忆故障。
MAIL_FAILOVER_COOLDOWN_SECONDS=120
# 内部服务间调用鉴权（独立支付服务调加额度接口 / 主服务代理下单）。生产必须设置为强随机串。
INTERNAL_API_TOKEN=
# 独立支付服务地址（主服务代理下单时调用）。
PAY_SERVICE_BASE_URL=http://127.0.0.1:8100
