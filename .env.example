# 复制为 .env 后填写。不要提交真实密钥。
# 模型 ID 以 DeepSeek 官方更新日志为准。下面的默认值核验于 2026-11-06。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_ALLOWLIST=deepseek-flash,deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_BACKOFF_SECONDS=0.2
# 本服务默认显式关闭思考模式。上游在省略 thinking 时默认开启。
DEEPSEEK_THINKING=disabled
LOG_LEVEL=INFO
REQUIRE_API_KEY_ON_STARTUP=false
EXPOSE_REASONING=false
MAX_TOOL_ROUNDS=3
TOOL_ROUND_HARD_LIMIT=5
TOOL_TIMEOUT_SECONDS=2
TOOL_RESULT_MAX_CHARS=4000
LLM_PROVIDER=deepseek
# Agent Runtime。这些值都有硬上限，请求不能放宽。
AGENT_MAX_ACTIVE_TASKS=8
AGENT_TASK_TTL_SECONDS=300
AGENT_SYNC_TOOL_CONCURRENCY=2
AGENT_CANCEL_CLEANUP_SECONDS=2
# 工具扩展。默认关闭网络和文件工具。工作区不能指向项目根目录。
# 推荐指向项目内的 agent_workspace，该目录只保留 .gitkeep，其余内容不提交。
TOOLS_NETWORK_ENABLED=false
TOOLS_WORKSPACE_ROOT=
TOOLS_NETWORK_CONCURRENCY=4
AGENT_MAX_ARTIFACTS=5
AGENT_MAX_ARTIFACT_CHARS=20000
# 联网工具。抓取由 DeepSeek 服务器执行，密钥复用 DEEPSEEK_API_KEY。
WEB_TOOLS_MAX_RETRIES=0
WEB_TOOLS_RETRY_BACKOFF_SECONDS=0.2
WEB_FETCH_URL_POLICY=provenance
WEB_SEARCH_SEND_ORI_QUESTION=false
WEB_RESPONSE_MAX_BYTES=2000000
WEB_FETCH_ALLOWED_DOMAINS=
WEB_FETCH_DENIED_DOMAINS=
WEB_FETCH_BLOCK_CREDENTIAL_QUERY=true
WEB_SEARCH_MAX_CALLS=5
WEB_FETCH_MAX_CALLS=5
# 数据处理。目录不能是项目根。文件保留时间和任务 TTL 彼此独立。
DATA_STORE_ROOT=data_store
DATA_FILE_TTL_SECONDS=3600
DATA_DOWNLOAD_TTL_SECONDS=600
DATA_MAX_ROWS=5000
DATA_MAX_BYTES=1000000
DATA_MAX_COLUMNS=64
DATA_SAMPLE_ROWS=3
DATA_MAX_PACKAGE_FILES=20
DATA_MAX_PACKAGE_BYTES=2000000
# 对象存储上传。留空时数据工具只返回本机短期下载路径。
# 地址指向 qs-oss 这种上传服务，不在这里填写 OSS AccessKey。
OSS_UPLOAD_BASE_URL=
OSS_UPLOAD_PREFIX=agent-data
OSS_UPLOAD_TIMEOUT_SECONDS=20
