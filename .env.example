# 复制为 .env 后填写。不要提交真实密钥。
# 模型 ID 以 DeepSeek 官方更新日志为准。下面的默认值核验于 2026-11-06。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TIMEOUT_SECONDS=180
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_ALLOWLIST=deepseek-flash,deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_BACKOFF_SECONDS=0.2
# 本服务默认显式关闭思考模式。上游在省略 thinking 时默认开启。
DEEPSEEK_THINKING=disabled
LOG_LEVEL=INFO
REQUIRE_API_KEY_ON_STARTUP=false
EXPOSE_REASONING=false
MAX_TOOL_ROUNDS=10
TOOL_ROUND_HARD_LIMIT=10
TOOL_TIMEOUT_SECONDS=2
TOOL_RESULT_MAX_CHARS=4000
# 工具固定计费（token）。系统内部只认 token，人民币换算在充值/定价系统。
# 命名约定 TOOL_PRICE_<工具名大写>_TOKENS，不写则用代码默认值。
# 图片生成：每成功生成一张图扣的 token（Seedream 0.12 元/张，暂定 150000）。
TOOL_PRICE_IMAGE_GENERATION_TOKENS=150000
# 文件交付：每次成功调用扣的 token。
TOOL_PRICE_DELIVER_FILE_TOKENS=2000
LLM_PROVIDER=deepseek
# Agent Runtime。这些值都有硬上限，请求不能放宽。
AGENT_MAX_ACTIVE_TASKS=8
AGENT_TASK_TTL_SECONDS=300
AGENT_SYNC_TOOL_CONCURRENCY=2
AGENT_CANCEL_CLEANUP_SECONDS=2
# 工具扩展。默认关闭网络和文件工具。工作区不能指向项目根目录。
# 推荐指向项目内的 agent_workspace，该目录只保留 .gitkeep，其余内容不提交。
# 线上请求按 X-Workspace-Key 进入独立子目录。没有合法密钥时不能读取根目录里的文件。
TOOLS_NETWORK_ENABLED=false
TOOLS_WORKSPACE_ROOT=
# 沙箱命令白名单，逗号分隔，只写命令名。默认不授权任何命令。
TOOLS_SANDBOX_COMMANDS=
TOOLS_SANDBOX_TIMEOUT_SECONDS=10
TOOLS_NETWORK_CONCURRENCY=4
AGENT_MAX_ARTIFACTS=5
AGENT_MAX_ARTIFACT_CHARS=20000
# 联网工具。抓取由 DeepSeek 服务器执行，密钥复用 DEEPSEEK_API_KEY。
WEB_TOOLS_MAX_RETRIES=0
WEB_TOOLS_RETRY_BACKOFF_SECONDS=0.2
WEB_FETCH_URL_POLICY=provenance
WEB_SEARCH_SEND_ORI_QUESTION=false
WEB_RESPONSE_MAX_BYTES=2000000
WEB_FETCH_ALLOWED_DOMAINS=
WEB_FETCH_DENIED_DOMAINS=
WEB_FETCH_BLOCK_CREDENTIAL_QUERY=true
WEB_SEARCH_MAX_CALLS=2
WEB_FETCH_MAX_CALLS=2
# 数据处理。目录不能是项目根。文件保留时间和任务 TTL 彼此独立。
DATA_STORE_ROOT=data_store
DATA_FILE_TTL_SECONDS=3600
DATA_DOWNLOAD_TTL_SECONDS=600
DATA_MAX_ROWS=5000
DATA_MAX_BYTES=1000000
DATA_MAX_COLUMNS=64
DATA_SAMPLE_ROWS=3
DATA_MAX_PACKAGE_FILES=20
DATA_MAX_PACKAGE_BYTES=2000000
# 对象存储上传。留空时数据工具只返回本机短期下载路径。
# 地址指向 qs-oss 这种上传服务，不在这里填写 OSS AccessKey。
OSS_UPLOAD_BASE_URL=
OSS_UPLOAD_PREFIX=agent-data
OSS_UPLOAD_TIMEOUT_SECONDS=20
# MCP。默认关闭。命令必须是本机可执行文件的绝对路径，参数用逗号分隔。
# 只导入白名单里的远端工具名。不要把密钥写进这里。
MCP_ENABLED=false
MCP_SERVER_NAME=server
MCP_COMMAND=
MCP_ARGS=
MCP_TOOL_ALLOWLIST=
MCP_TOOLS_NETWORK=false
MCP_TIMEOUT_SECONDS=10
# 远程 MCP。目录在 app/mcp/connectors.toml。令牌加密密钥只放在本机 .env。
MCP_TOKEN_KEY=
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8000
MCP_FRONTEND_BASE_URL=http://127.0.0.1:5500
MCP_ALLOW_INSECURE=false
# 数据库。密码只放在本机 .env，不写进此示例。
# Windows 本机运行时主机用 127.0.0.1。FastAPI 进入 Docker 后改为 postgres / redis。
# 复制 deploy/docker/.env 里生成的密码后再把 DATABASE_STARTUP_REQUIRED 改为 true。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=muzi_llm
POSTGRES_USER=muzi_admin
POSTGRES_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
DATABASE_STARTUP_REQUIRED=false
# 技能包注册表目录。相对路径相对服务根目录。留空时不加载注册表技能。
SKILLS_ROOT=skills_data
# 阿里云短信。四项都填写后，登录页「获取验证码」才会真正下发。
# 模板变量名需与短信模板一致，默认模板里写 ${code}。
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_TEMPLATE_PARAM_KEY=code
SMS_ENDPOINT=dysmsapi.aliyuncs.com
SMS_CODE_TTL_SECONDS=300
SMS_COOLDOWN_SECONDS=60
SMS_CODE_LENGTH=6
# 回执队列。开通云通信消息回执后填写队列名，再把开关改为 true。
# 队列名形如 Alicom-Queue-账号ID-SmsReport。MNS 地址使用云通信固定域名。
SMS_RECEIPT_ENABLED=false
SMS_MNS_ENDPOINT=https://1943695596114318.mns.cn-hangzhou.aliyuncs.com
SMS_MNS_QUEUE_NAME=
SMS_MNS_MESSAGE_TYPE=SmsReport
