{
  "$defs": {
    "PlanningEventType": {
      "enum": [
        "chat.run.started",
        "chat.delta",
        "chat.tool",
        "chat.status",
        "chat.done",
        "chat.error",
        "chat.cancelled",
        "plan.created",
        "plan.updated",
        "plan.approved",
        "plan.paused",
        "plan.resumed",
        "plan.cancelled",
        "plan.completed",
        "interaction.ready",
        "interaction.required",
        "interaction.submitted",
        "interaction.skipped",
        "conversation.mode_changed",
        "handoff.created",
        "run.started",
        "run.progress",
        "run.completed",
        "run.failed",
        "run.cancelled"
      ],
      "title": "PlanningEventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "conversation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Conversation Id",
      "type": "string"
    },
    "plan_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Id"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "type": {
      "$ref": "#/$defs/PlanningEventType"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "sequence",
    "conversation_id",
    "type",
    "occurred_at"
  ],
  "title": "PlanningEvent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
