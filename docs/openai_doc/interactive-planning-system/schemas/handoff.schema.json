      "type": "string"
    },
    "conversation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Conversation Id",
      "type": "string"
    },
    "approved_plan_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Approved Plan Id",
      "type": "string"
    },
    "approved_revision": {
      "minimum": 0,
